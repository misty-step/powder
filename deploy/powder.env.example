# Copy this file to /etc/powder/powder.env and adjust the bind address for
# the host. The systemd unit permits writes only below /var/lib/powder.
POWDER_BIND_ADDR=127.0.0.1:4000
POWDER_DB_PATH=/var/lib/powder/ledger.db
POWDER_BOOTSTRAP_KEY_FILE=/var/lib/powder/bootstrap.key
POWDER_LEASE_TTL=4h
POWDER_AUTH_MODE=api-key
